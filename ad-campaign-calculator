<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ad Campaign Calculator</title>
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; background: #f3f7fb; color: #17283a; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .wrap { max-width: 1180px; margin: 25px auto; padding: 0 14px; }
        .head { background: linear-gradient(135deg, #123b63, #216c9e); color: #fff; padding: 26px; border-radius: 18px 18px 0 0; }
        .head h1 { margin: 0 0 7px; font-size: 30px; }
        .head p { margin: 0; color: #dcebf7; }
        .box { background: #fff; padding: 24px; border: 1px solid #d8e4ed; border-top: 0; border-radius: 0 0 18px 18px; }
        section { margin-bottom: 25px; }
        h2 { font-size: 19px; color: #123b63; border-bottom: 2px solid #e5edf4; padding-bottom: 9px; }
        .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
        .field { display: flex; flex-direction: column; }
        .field label { font-size: 12px; font-weight: bold; margin-bottom: 6px; color: #40566b; }
        .field label span { color: #d11; }
        input, select { height: 43px; border: 1px solid #c8d6e2; border-radius: 9px; padding: 0 11px; font-size: 14px; background: #fff; color: #17283a; }
        input:focus, select:focus { outline: none; border-color: #2778ad; box-shadow: 0 0 0 3px #2778ad18; }
        input:disabled { background: #edf2f6; color: #9aa8b3; cursor: not-allowed; }
        .budget { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 14px; }
        .budget .field { background: #f7fafc; border: 1px solid #e0e8ef; border-radius: 12px; padding: 13px; }
        .note { font-size: 11px; color: #72859a; line-height: 1.5; margin-top: 8px; }
        .buttons { display: flex; gap: 9px; margin-top: 15px; }
        .btn { border: 0; border-radius: 9px; padding: 12px 22px; font-weight: bold; cursor: pointer; font-size: 14px; }
        .calc { background: #123b63; color: #fff; }
        .calc:hover { background: #1b538a; }
        .reset { background: #e8eff5; color: #123b63; }
        .reset:hover { background: #d3e1ed; }
        .error { display: none; background: #fff0f0; color: #a71919; border: 1px solid #eab3b3; border-radius: 9px; padding: 11px; margin: 15px 0; font-size: 13px; }
        .results { display: none; margin-top: 25px; }
        .results.show { display: block; }
        .resulthead { background: #123b63; color: #fff; padding: 17px 20px; border-radius: 14px 14px 0 0; }
        .resulthead h2 { color: #fff; border: 0; margin: 0; padding: 0; }
        .benchmarkTag { display: inline-block; background: #ffffff22; border: 1px solid #ffffff55; color: #eaf3fb; font-size: 11px; padding: 5px 10px; border-radius: 20px; margin-top: 8px; }
        .cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin: 14px 0; }
        .card { background: #fff; border: 1px solid #d6e3ed; border-radius: 12px; padding: 14px; box-shadow: 0 4px 15px #123b6310; }
        .label { font-size: 10px; text-transform: uppercase; color: #718396; font-weight: bold; }
        .value { font-size: 18px; font-weight: 800; color: #123b63; margin-top: 5px; }
        .platforms { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 15px; }
        .pcard { background: #fff; border: 1px solid #d6e3ed; border-radius: 13px; padding: 16px; }
        .pcard h3 { margin: 0 0 12px; color: #123b63; font-size: 16px; }
        .metrics { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
        .metric { background: #f5f9fc; padding: 9px; border-radius: 8px; }
        .metric small { display: block; color: #718396; font-size: 9px; text-transform: uppercase; }
        .metric strong { display: block; color: #173d62; font-size: 13px; margin-top: 3px; }
        .tablewrap { overflow: auto; margin-top: 14px; border: 1px solid #e1e9ef; border-radius: 12px; }
        .table { width: 100%; border-collapse: collapse; background: #fff; }
        .table th { background: #123b63; color: #fff; padding: 11px; font-size: 11px; text-align: center; }
        .table td { padding: 10px; border-bottom: 1px solid #e1e9ef; font-size: 12px; text-align: center; color: #334e68; }
        .table tr:last-child td { font-weight: bold; background: #edf5fb; }
        @media(max-width: 900px) {
            .grid, .budget { grid-template-columns: repeat(2, 1fr); }
            .cards { grid-template-columns: repeat(2, 1fr); }
            .platforms { grid-template-columns: 1fr; }
        }
        @media(max-width: 600px) {
            .wrap { margin: 8px auto; padding: 0 7px; }
            .head { padding: 20px 16px; }
            .head h1 { font-size: 22px; }
            .box { padding: 16px; }
            .grid, .budget { grid-template-columns: 1fr; }
            .cards { grid-template-columns: 1fr; }
            .buttons { flex-direction: column; }
            .btn { width: 100%; }
        }
    </style>
</head>
<body>
    <div class="wrap">
        <div class="head">
            <h1>Ad Campaign Calculator</h1>
            <p>Plan and estimate professional Google, Meta, Facebook, and Instagram advertising performance.</p>
        </div>
        <div class="box">

            <!-- SECTION 1: CAMPAIGN INFORMATION -->
            <section>
                <h2>1. Campaign Information</h2>
                <div class="grid">
                    <div class="field">
                        <label>Product / Service Name <span>*</span></label>
                        <input id="product" placeholder="e.g. Luxury Real Estate">
                    </div>
                    <div class="field">
                        <label>Industry / Business Type <span>*</span></label>
                        <input id="industry" placeholder="e.g. Real Estate, E-commerce">
                    </div>
                    <div class="field">
                        <label>Platform <span>*</span></label>
                        <select id="platform" onchange="platformChange()">
                            <option value="">Select platform</option>
                            <option value="Google">Google</option>
                            <option value="Meta">Meta</option>
                            <option value="Google and meta">Google and meta</option>
                            <option value="Facebook">Facebook</option>
                            <option value="Instagram">Instagram</option>
                        </select>
                    </div>
                    <div class="field">
                        <label>Ad Campaign Type <span>*</span></label>
                        <select id="type">
                            <option value="">Select platform first</option>
                        </select>
                    </div>
                    <div class="field">
                        <label>Goal & Objective <span>*</span></label>
                        <select id="goal">
                            <option value="">Select goal first</option>
                        </select>
                    </div>
                    <div class="field">
                        <label>Budget Level <span>*</span></label>
                        <select id="level">
                            <option value="">Select level</option>
                            <option value="Campaign Level">Campaign Level</option>
                            <option value="Ad Group / Ad Set Level">Ad Group / Ad Set Level</option>
                        </select>
                    </div>
                    <div class="field">
                        <label>Duration (Days) <span>*</span></label>
                        <input id="days" type="number" min="1" placeholder="30">
                    </div>
                    <div class="field">
                        <label>Targeted Location <span>*</span></label>
                        <input id="location" placeholder="e.g. Dubai, UAE">
                    </div>
                    <div class="field">
                        <label>Audience Type <span>*</span></label>
                        <select id="audience">
                            <option value="">Select audience</option>
                            <option value="Broad">Broad</option>
                            <option value="Interest Based">Interest Based</option>
                            <option value="Lookalike">Lookalike</option>
                            <option value="Remarketing">Remarketing</option>
                            <option value="Custom Audience">Custom Audience</option>
                            <option value="High Intent">High Intent</option>
                        </select>
                    </div>
                    <div class="field" style="grid-column: span 3;">
                        <label>Placement / Network <span>*</span></label>
                        <select id="placement">
                            <option value="">Select placement</option>
                            <option value="Automatic / Recommended">Automatic / Recommended</option>
                            <option value="Google Search Network">Google Search Network</option>
                            <option value="Google Display Network">Google Display Network</option>
                            <option value="YouTube">YouTube</option>
                            <option value="Facebook Feed & Stories">Facebook Feed & Stories</option>
                            <option value="Instagram Feed & Reels">Instagram Feed & Reels</option>
                        </select>
                    </div>
                </div>
            </section>

            <!-- SECTION 2: BUDGET & CURRENCY -->
            <section>
                <h2>2. Budget & Currency Allocation</h2>
                <div class="grid">
                    <div class="field">
                        <label>Currency <span>*</span></label>
                        <select id="currency">
                            <option value="">Select currency</option>
                            <option value="USD">USD ($)</option>
                            <option value="AED">AED (د.إ)</option>
                            <option value="SAR">Saudi Riyal (﷼)</option>
                            <option value="EUR">Euro (€)</option>
                            <option value="GBP">Pound (£)</option>
                            <option value="CNY">CNY (¥)</option>
                            <option value="PKR">PKR (₨)</option>
                            <option value="INR">INR (₹)</option>
                            <option value="TRY">Turkish Lira (₺)</option>
                            <option value="RUB">Russian Ruble (₽)</option>
                            <option value="OTHER">Other Currency</option>
                        </select>
                    </div>
                    <div class="field" style="grid-column: span 2;">
                        <label>Total Budget <span>*</span></label>
                        <input id="totalBudget" type="number" min="0.01" step="0.01" placeholder="10000">
                    </div>
                </div>

                <div class="budget">
                    <div class="field">
                        <label>Google Budget</label>
                        <input id="googleBudget" type="number" min="0" step="0.01" placeholder="0">
                    </div>
                    <div class="field">
                        <label>Facebook Budget</label>
                        <input id="facebookBudget" type="number" min="0" step="0.01" placeholder="0">
                    </div>
                    <div class="field">
                        <label>Instagram Budget</label>
                        <input id="instagramBudget" type="number" min="0" step="0.01" placeholder="0">
                    </div>
                </div>
                <p class="note">Note: Individual platform budgets must sum up to equal the Total Budget when multiple platforms are selected. Leave them blank to split the Total Budget evenly instead.</p>
            </section>

            <div class="error" id="errorBox"></div>

            <div class="buttons">
                <button class="btn calc" onclick="calculateCampaign()">Calculate Campaign Analytics</button>
                <button class="btn reset" onclick="resetForm()">Reset Form</button>
            </div>

            <!-- SECTION 3: RESULTS -->
            <div class="results" id="resultsSection">
                <div class="resulthead">
                    <h2>Campaign Results & Analytics Dashboard</h2>
                    <div class="benchmarkTag" id="benchmarkTag"></div>
                </div>
                <div class="cards" id="metricsCards"></div>

                <div class="platforms" id="platformsBreakdown"></div>

                <div class="tablewrap">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Metric Name</th>
                                <th>Calculated Result</th>
                                <th>Formula / Description</th>
                            </tr>
                        </thead>
                        <tbody id="detailedTableBody"></tbody>
                    </table>
                </div>
                <p class="note">Disclaimer: Estimates are derived from standard digital marketing benchmark metrics and are subject to market conditions.</p>
            </div>

        </div>
    </div>

    <script>
        const $ = id => document.getElementById(id);
        const val = id => $(id).value.trim();
        const num = id => parseFloat($(id).value) || 0;

        const campaignTypesMap = {
            "Google": ["Search", "Display", "YouTube Video", "Performance Max", "Shopping"],
            "Meta": ["Conversions / Sales", "Lead Generation", "Traffic", "Brand Awareness"],
            "Google and meta": ["Omnichannel Search & Social", "Lead Generation Mix", "E-commerce Catalog Growth"],
            "Facebook": ["Facebook Feed & Stories", "Lead Generation Ads", "Messenger / WhatsApp Ads"],
            "Instagram": ["Instagram Reels & Feed", "Story Ads", "Shopping Ads"]
        };

        const goalsMap = {
            "Google": ["Leads", "Sales / Purchases", "Website Traffic", "Brand Awareness", "App Promotion"],
            "Meta": ["Sales", "Leads", "Traffic", "Engagement", "Awareness", "App Installs"],
            "Google and meta": ["Lead Generation", "E-commerce Sales", "Website Traffic", "Brand Awareness"],
            "Facebook": ["Lead Generation", "Sales", "Traffic", "Engagement", "Community Growth"],
            "Instagram": ["Brand Awareness", "Sales", "Engagement", "Profile Visits", "Reels Views"]
        };

        // FIX: currency codes now map to their real symbols instead of printing
        // the raw select value (e.g. "EUR 1,234.56" -> "€ 1,234.56").
        const currencySymbols = {
            "USD": "$", "AED": "د.إ", "SAR": "﷼", "EUR": "€", "GBP": "£",
            "CNY": "¥", "PKR": "₨", "INR": "₹", "TRY": "₺", "RUB": "₽", "OTHER": "$"
        };

        // FIX: industry benchmarks now carry a list of aliases (all normalized:
        // lowercase, no spaces/hyphens/underscores) so "Ecommerce", "E-Commerce",
        // "e commerce" and "Online Store" all correctly match the same benchmark,
        // instead of silently falling back to "default" pricing whenever the
        // exact phrase "real estate" / "e-commerce" wasn't typed verbatim.
        const industryBenchmarks = [
            {
                label: "Real Estate",
                aliases: ["realestate", "property", "properties", "realty", "realtor"],
                cpc: 2.50, cpm: 12.00, leadRate: 0.05, salesRate: 0.015, ltv: 8000
            },
            {
                label: "E-commerce",
                aliases: ["ecommerce", "onlinestore", "onlineshop", "retail", "dtc", "shopify"],
                cpc: 0.95, cpm: 8.50, leadRate: 0.08, salesRate: 0.035, ltv: 120
            },
            {
                label: "Finance",
                aliases: ["finance", "financial", "banking", "insurance", "fintech", "loans"],
                cpc: 3.80, cpm: 18.00, leadRate: 0.04, salesRate: 0.02, ltv: 1500
            },
            {
                label: "Education",
                aliases: ["education", "elearning", "university", "college", "school", "course", "courses"],
                cpc: 1.80, cpm: 10.00, leadRate: 0.06, salesRate: 0.025, ltv: 2500
            }
        ];
        const defaultBenchmark = {
            label: "General / Default",
            cpc: 1.50, cpm: 10.00, leadRate: 0.06, salesRate: 0.025, ltv: 350
        };

        // Normalize text for matching: lowercase, strip spaces/hyphens/underscores/slashes.
        function normalizeIndustry(text) {
            return text.toLowerCase().replace(/[\s\-_/]+/g, '');
        }

        function matchBenchmark(industryInput) {
            const normalized = normalizeIndustry(industryInput);
            for (const bench of industryBenchmarks) {
                for (const alias of bench.aliases) {
                    if (normalized.includes(alias)) return bench;
                }
            }
            return defaultBenchmark;
        }

        function platformChange() {
            const platform = val('platform');
            const typeSelect = $('type');
            const goalSelect = $('goal');

            typeSelect.innerHTML = '<option value="">Select campaign type</option>';
            goalSelect.innerHTML = '<option value="">Select goal</option>';

            if (!platform) {
                $('googleBudget').disabled = false;
                $('facebookBudget').disabled = false;
                $('instagramBudget').disabled = false;
                return;
            }

            // Populate Campaign Types
            const types = campaignTypesMap[platform] || [];
            types.forEach(t => {
                const opt = document.createElement('option');
                opt.value = t;
                opt.textContent = t;
                typeSelect.appendChild(opt);
            });

            // Populate Goals
            const goals = goalsMap[platform] || [];
            goals.forEach(g => {
                const opt = document.createElement('option');
                opt.value = g;
                opt.textContent = g;
                goalSelect.appendChild(opt);
            });

            // Enable / disable budgets based on platform selection
            const gInput = $('googleBudget');
            const fInput = $('facebookBudget');
            const iInput = $('instagramBudget');

            const isGoogleActive = (platform === 'Google' || platform === 'Google and meta');
            const isFbActive = (platform === 'Meta' || platform === 'Google and meta' || platform === 'Facebook');
            const isIgActive = (platform === 'Meta' || platform === 'Google and meta' || platform === 'Instagram');

            gInput.disabled = !isGoogleActive;
            fInput.disabled = !isFbActive;
            iInput.disabled = !isIgActive;

            if (!isGoogleActive) gInput.value = '';
            if (!isFbActive) fInput.value = '';
            if (!isIgActive) iInput.value = '';
        }

        function showError(msg) {
            const box = $('errorBox');
            box.textContent = msg;
            box.style.display = 'block';
            box.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }

        function hideError() {
            $('errorBox').style.display = 'none';
        }

        function formatMoney(amount, currencyCode) {
            const sym = currencySymbols[currencyCode] || '$';
            if (!isFinite(amount)) amount = 0; // FIX: never render NaN/Infinity to the user
            return `${sym} ${amount.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
        }

        function formatNumber(n) {
            if (!isFinite(n)) n = 0; // FIX: never render NaN/Infinity to the user
            return n.toLocaleString(undefined, { maximumFractionDigits: 2 });
        }

        // FIX: safe division helper used everywhere a ratio is computed, so a
        // zero denominator produces 0 instead of NaN/Infinity bleeding into
        // every downstream metric and card.
        function safeDiv(a, b) {
            return b > 0 ? a / b : 0;
        }

        function calculateCampaign() {
            // Validate required fields
            const requiredFields = [
                ['product', 'Product / Service Name'],
                ['industry', 'Industry / Business Type'],
                ['platform', 'Platform'],
                ['type', 'Ad Campaign Type'],
                ['goal', 'Goal & Objective'],
                ['level', 'Budget Level'],
                ['days', 'Duration'],
                ['location', 'Targeted Location'],
                ['audience', 'Audience Type'],
                ['placement', 'Placement / Network'],
                ['currency', 'Currency'],
                ['totalBudget', 'Total Budget']
            ];

            for (let field of requiredFields) {
                if (!val(field[0])) {
                    showError(`Please fill in the required field: ${field[1]}`);
                    $(field[0]).focus();
                    return;
                }
            }

            const platform = val('platform');
            const total = num('totalBudget');

            // FIX: reject zero / negative total budgets instead of letting them
            // silently produce Infinity/NaN across every metric.
            if (total <= 0) {
                showError('Total Budget must be greater than 0.');
                $('totalBudget').focus();
                return;
            }

            const gB = num('googleBudget');
            const fB = num('facebookBudget');
            const iB = num('instagramBudget');

            // FIX: reject negative platform budgets (HTML min="0" is not enforced by JS).
            if (gB < 0 || fB < 0 || iB < 0) {
                showError('Platform budgets cannot be negative.');
                return;
            }

            // Collect active platform budgets
            let activeBudgets = [];
            if (! $('googleBudget').disabled && gB > 0) activeBudgets.push({ name: 'Google Ads', budget: gB });
            if (! $('facebookBudget').disabled && fB > 0) activeBudgets.push({ name: 'Facebook Ads', budget: fB });
            if (! $('instagramBudget').disabled && iB > 0) activeBudgets.push({ name: 'Instagram Ads', budget: iB });

            // If user left platform budgets empty, distribute total budget evenly among active channels
            if (activeBudgets.length === 0) {
                if (platform === 'Google and meta') {
                    activeBudgets.push({ name: 'Google Ads', budget: total / 2 });
                    activeBudgets.push({ name: 'Meta Ads', budget: total / 2 });
                } else if (platform === 'Meta') {
                    activeBudgets.push({ name: 'Facebook Ads', budget: total / 2 });
                    activeBudgets.push({ name: 'Instagram Ads', budget: total / 2 });
                } else {
                    activeBudgets.push({ name: platform + ' Ads', budget: total });
                }
            } else {
                let sumBudgets = activeBudgets.reduce((acc, curr) => acc + curr.budget, 0);
                if (Math.abs(sumBudgets - total) > 0.01) {
                    showError(`Platform budgets sum (${sumBudgets.toFixed(2)}) must equal Total Budget (${total.toFixed(2)}).`);
                    return;
                }
            }

            hideError();

            const days = parseInt(val('days')) || 30;
            const currency = val('currency');
            const industryInput = val('industry');

            // FIX: robust, alias-based benchmark matching (see matchBenchmark/normalizeIndustry above)
            const bench = matchBenchmark(industryInput);
            $('benchmarkTag').textContent = `Benchmark profile used: ${bench.label}`;

            let totalSpend = 0, totalImpressions = 0, totalClicks = 0, totalLeads = 0, totalConversions = 0, totalRevenue = 0;
            let platformHtml = '';

            activeBudgets.forEach(item => {
                const b = item.budget;
                const clicks = b / bench.cpc;
                const impressions = b / (bench.cpm / 1000);
                const ctr = safeDiv(clicks, impressions) * 100;
                const leads = clicks * bench.leadRate;
                const conversions = leads * bench.salesRate;
                const revenue = conversions * bench.ltv;
                const cpl = safeDiv(b, leads);
                const cpa = safeDiv(b, conversions);
                const roas = safeDiv(revenue, b);

                totalSpend += b;
                totalImpressions += impressions;
                totalClicks += clicks;
                totalLeads += leads;
                totalConversions += conversions;
                totalRevenue += revenue;

                platformHtml += `
                    <div class="pcard">
                        <h3>${item.name}</h3>
                        <div class="metrics">
                            <div class="metric"><small>Spend</small><strong>${formatMoney(b, currency)}</strong></div>
                            <div class="metric"><small>Impressions</small><strong>${formatNumber(impressions)}</strong></div>
                            <div class="metric"><small>Clicks</small><strong>${formatNumber(clicks)}</strong></div>
                            <div class="metric"><small>CTR</small><strong>${ctr.toFixed(2)}%</strong></div>
                            <div class="metric"><small>Leads</small><strong>${formatNumber(leads)}</strong></div>
                            <div class="metric"><small>CPL</small><strong>${formatMoney(cpl, currency)}</strong></div>
                            <div class="metric"><small>Conversions</small><strong>${formatNumber(conversions)}</strong></div>
                            <div class="metric"><small>CPA</small><strong>${formatMoney(cpa, currency)}</strong></div>
                            <div class="metric"><small>Revenue</small><strong>${formatMoney(revenue, currency)}</strong></div>
                            <div class="metric"><small>ROAS</small><strong>${roas.toFixed(2)}×</strong></div>
                        </div>
                    </div>
                `;
            });

            // Aggregate metrics (all divisions guarded against zero)
            const overallCtr = safeDiv(totalClicks, totalImpressions) * 100;
            const overallCpc = safeDiv(totalSpend, totalClicks);
            const overallCpm = safeDiv(totalSpend, totalImpressions) * 1000;
            const overallCpl = safeDiv(totalSpend, totalLeads);
            const overallCpa = safeDiv(totalSpend, totalConversions);
            const overallRoas = safeDiv(totalRevenue, totalSpend);

            // Render Summary Cards
            const cardsData = [
                ["Total Spend", formatMoney(totalSpend, currency)],
                ["Impressions", formatNumber(totalImpressions)],
                ["Clicks", formatNumber(totalClicks)],
                ["CTR", overallCtr.toFixed(2) + "%"],
                ["CPC", formatMoney(overallCpc, currency)],
                ["CPM", formatMoney(overallCpm, currency)],
                ["Leads", formatNumber(totalLeads)],
                ["CPL", formatMoney(overallCpl, currency)],
                ["Conversions", formatNumber(totalConversions)],
                ["CPA", formatMoney(overallCpa, currency)],
                ["Revenue", formatMoney(totalRevenue, currency)],
                ["ROAS", overallRoas.toFixed(2) + "×"]
            ];

            $('metricsCards').innerHTML = cardsData.map(c => `
                <div class="card">
                    <div class="label">${c[0]}</div>
                    <div class="value">${c[1]}</div>
                </div>
            `).join('');

            $('platformsBreakdown').innerHTML = platformHtml;

            // Render Detailed Table
            const tableRows = [
                ["Total Budget", formatMoney(totalSpend, currency), "Total campaign investment allocated"],
                ["Daily Budget", formatMoney(safeDiv(totalSpend, days), currency), "Total budget ÷ campaign duration days"],
                ["Total Impressions", formatNumber(totalImpressions), "Total ad views across platforms"],
                ["Total Clicks", formatNumber(totalClicks), "Total user engagement clicks"],
                ["Click-Through Rate (CTR)", overallCtr.toFixed(2) + "%", "Total clicks ÷ impressions × 100"],
                ["Cost Per Click (CPC)", formatMoney(overallCpc, currency), "Total spend ÷ total clicks"],
                ["Cost Per Mille (CPM)", formatMoney(overallCpm, currency), "Cost per 1,000 impressions"],
                ["Projected Leads", formatNumber(totalLeads), "Clicks × estimated lead conversion rate"],
                ["Cost Per Lead (CPL)", formatMoney(overallCpl, currency), "Total spend ÷ total leads generated"],
                ["Projected Sales / Conversions", formatNumber(totalConversions), "Leads × conversion rate to sales"],
                ["Cost Per Acquisition (CPA)", formatMoney(overallCpa, currency), "Total spend ÷ total conversions"],
                ["Projected Revenue", formatMoney(totalRevenue, currency), "Conversions × average customer lifetime value"],
                ["Return on Ad Spend (ROAS)", overallRoas.toFixed(2) + "×", "Total revenue generated ÷ total ad spend"]
            ];

            $('detailedTableBody').innerHTML = tableRows.map(r => `
                <tr>
                    <td>${r[0]}</td>
                    <td>${r[1]}</td>
                    <td>${r[2]}</td>
                </tr>
            `).join('');

            $('resultsSection').classList.add('show');
            $('resultsSection').scrollIntoView({ behavior: 'smooth' });
        }

        function resetForm() {
            document.querySelectorAll('input').forEach(i => i.value = '');
            document.querySelectorAll('select').forEach(s => s.selectedIndex = 0);
            $('type').innerHTML = '<option value="">Select platform first</option>';
            $('goal').innerHTML = '<option value="">Select goal first</option>';
            $('googleBudget').disabled = false;
            $('facebookBudget').disabled = false;
            $('instagramBudget').disabled = false;
            $('errorBox').style.display = 'none';
            $('resultsSection').classList.remove('show');
        }
    </script>
</body>
</html>
